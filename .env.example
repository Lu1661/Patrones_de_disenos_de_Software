# Copiar este archivo como .env y completar los valores localmente.
# Nunca se debe subir el archivo .env al repositorio.

FLASK_DEBUG=false
CLAVE_SECRETA=cambiar_en_el_entorno_local
COOKIE_SEGURA=false
ADMIN_USUARIO=admin
ADMIN_PASSWORD=completar_localmente
SUPERVISOR_USUARIO=supervisor
SUPERVISOR_PASSWORD=completar_localmente
VENDEDOR_USUARIO=vendedor
VENDEDOR_PASSWORD=completar_localmente

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_BASE_DATOS=financorp_db
MYSQL_USUARIO=completar_localmente
MYSQL_PASSWORD=completar_localmente

